<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SodCoop</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Game install; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Shadows of Doubt</GameDir>
    <!-- Game types to compile against. CI uses the stripped copies in lib/refs: -p:InteropDir=../../lib/refs -->
    <InteropDir Condition="'$(InteropDir)' == ''">$(GameDir)/BepInEx/interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(InteropDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(InteropDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

  <!-- -p:CopyToGame=false (CI) only builds, without touching a game folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CopyToGame)' != 'false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/BepInEx/plugins" />
  </Target>

</Project>
